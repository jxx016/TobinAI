{
  "name": "Waitlist Email Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "waitlist-signup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate the incoming data\nconst input = $input.first().json;\n\n// Log for debugging\nconsole.log('Received waitlist signup:', input);\n\n// Format the data\nconst formattedData = {\n  name: input.name || 'Unknown',\n  email: input.email || '',\n  property_count: input.property_count || 'Not specified',\n  source: input.source || 'waitlist',\n  timestamp: input.timestamp || new Date().toISOString(),\n  signup_date: new Date().toLocaleDateString('en-US', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric'\n  })\n};\n\nreturn { json: formattedData };"
      },
      "id": "code-1",
      "name": "Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Properties": "={{ $json.property_count }}",
            "Source": "={{ $json.source }}",
            "Signed Up": "={{ $json.signup_date }}"
          }
        },
        "options": {}
      },
      "id": "sheets-1",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [650, 200],
      "notes": "Save lead to spreadsheet"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Welcome to the Tobin AI Waitlist! 🎉",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Segoe UI', Arial, sans-serif; background: #0a0a0a; color: #ffffff; margin: 0; padding: 0; }\n    .container { max-width: 600px; margin: 0 auto; padding: 40px 20px; }\n    .header { text-align: center; margin-bottom: 30px; }\n    .logo { font-size: 28px; font-weight: bold; color: #00d4ff; }\n    .card { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: 16px; padding: 32px; border: 1px solid rgba(0, 212, 255, 0.2); }\n    h1 { color: #00d4ff; margin: 0 0 16px 0; font-size: 24px; }\n    p { color: #94a3b8; line-height: 1.6; margin: 0 0 16px 0; }\n    .highlight { color: #00d4ff; font-weight: 600; }\n    .benefits { background: rgba(0, 212, 255, 0.1); border-radius: 12px; padding: 20px; margin: 24px 0; }\n    .benefits li { color: #e2e8f0; margin-bottom: 8px; }\n    .footer { text-align: center; margin-top: 30px; color: #64748b; font-size: 14px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <div class=\"logo\">🤖 Tobin AI</div>\n    </div>\n    <div class=\"card\">\n      <h1>You're on the list, {{ $json.name }}!</h1>\n      <p>Thank you for joining the Tobin AI waitlist. You're now among the first to experience the future of AI-powered property management.</p>\n      \n      <div class=\"benefits\">\n        <p style=\"color: #00d4ff; font-weight: 600; margin-bottom: 12px;\">As an early adopter, you'll get:</p>\n        <ul>\n          <li>🚀 Priority access when we launch</li>\n          <li>💰 Exclusive founding member pricing</li>\n          <li>🎯 Direct input on features we build</li>\n          <li>🎁 Special bonuses for early supporters</li>\n        </ul>\n      </div>\n      \n      <p>We're working hard to bring you an AI assistant that will transform how you manage properties. Expect updates soon!</p>\n      \n      <p style=\"margin-top: 24px;\">\n        Cheers,<br>\n        <span class=\"highlight\">The Tobin AI Team</span>\n      </p>\n    </div>\n    <div class=\"footer\">\n      <p>© 2024 Tobin AI. All rights reserved.</p>\n      <p>You're receiving this because you signed up at tobinai.com</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "gmail-1",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [650, 400],
      "notes": "Send confirmation email"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Successfully added to waitlist\",\n  \"name\": \"{{ $json.name }}\"\n}",
        "options": {}
      },
      "id": "respond-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Format Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Data": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Welcome Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Welcome Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

