# Copy to .env. Defaults run the full loop locally with no live credentials.
# MOCK_EXTERNAL_SERVICES=true skips Tavily, Firecrawl, Resend, Twilio, and Cal.com.

# --- Safety switch ---
# true: enrichment, email, SMS, and calendar use sandbox adapters.
# false: those adapters call the providers below and require their keys.
MOCK_EXTERNAL_SERVICES=true

# --- App database (SQLAlchemy). SQLite is the local default. ---
# Postgres example: postgresql+psycopg://lead:lead@localhost:5432/leadchase
DATABASE_URL=sqlite:///./var/lead_chase.db

# LangGraph checkpointer + cross-lead tactic store.
# Empty uses InMemorySaver / InMemoryStore (fine for local runs and tests).
# A postgres URL uses PostgresSaver and PostgresStore, with in-memory fallback
# if the driver or database is unreachable.
# If this is empty and DATABASE_URL is postgres, that URL is reused.
CHECKPOINT_DATABASE_URL=

# --- Chat model ---
# If either key is set, drafting and reflection use that model.
# With neither key, a deterministic mock classifier/drafter is used.
# The rubric critic and opt-out / injection / pricing gates stay in code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- LangSmith (optional; never required) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lead-chase-agent

# --- Web enrichment (used only when MOCK_EXTERNAL_SERVICES=false) ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@example.com

# --- SMS / WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# --- Calendar (Cal.com v2) ---
CALCOM_API_KEY=
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_USERNAME=
CALCOM_EVENT_TYPE_ID=

# --- Process ---
REFLECTION_OUTPUT_DIR=./var/reflection
FOLLOWUP_POLL_SECONDS=60
NIGHTLY_REFLECTION_HOUR=2
SCHEDULER_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
